# ── Supabase (Project Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── DeepSeek (gere uma chave NOVA) ──
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
LIMITE_IA_MES=200
IA_GRATIS=3

# ── Cakto ──
CAKTO_WEBHOOK_SECRET=
# IDs dos produtos/ofertas (product.id, product.short_id ou offer.id). Pode separar vários por vírgula.
CAKTO_PRODUTO_ESSENCIAL=
CAKTO_PRODUTO_CONTRATOS=
CAKTO_PRODUTO_COMPLETO=
CAKTO_PRODUTO_IA=

# ── Página de vendas ──
NEXT_PUBLIC_CHECKOUT_URL=https://pay.cakto.com.br/SEU-LINK
NEXT_PUBLIC_CHECKOUT_CONTRATOS_URL=
NEXT_PUBLIC_CHECKOUT_COMPLETO_URL=
NEXT_PUBLIC_CHECKOUT_IA_URL=
# Data REAL de fim do preço de lançamento (vazio = sem contador). Ex.: 2026-11-30T23:59:00-03:00
NEXT_PUBLIC_FIM_LANCAMENTO=
# Ex.: ou 3x de R$ 10,15 no cartão (confira na Cakto)
NEXT_PUBLIC_PARCELAS=
NEXT_PUBLIC_EMAIL_SUPORTE=berdnaski1177@gmail.com
